# Adapter selection
# mock is the safe default and reports SIMULATED.
ADAPTER=mock                       # mock | real | docker-compose
# Required only when ADAPTER=real. No real adapter is implemented in this repository.
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_TOKEN=
ORCHESTRATOR_TIMEOUT_MS=10000

# Auth
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ORGANIZER_ADMIN_USERNAME=admin
ORGANIZER_ADMIN_PASSWORD=change-me
ORGANIZER_OPERATOR_USERNAME=operator
ORGANIZER_OPERATOR_PASSWORD=change-me

# Mock behaviour
SEED_TEAMS=24
DEMO_CONTROLS=false               # development rehearsal only; never enable in release
MOCK_DURATION_SCALE=1
DB_PATH=./data/defcon.db          # durable storage; required explicitly in production

# Dev only
ALLOW_DEFAULT_PASSWORDS=false     # development mock rehearsal only

# Health source (docs/12 D17-D18). mock = seeded data. Never put tokens in URLs.
HEALTH_SOURCE=mock                # mock | scoreboard | ingest
HEALTH_SCOREBOARD_URL=            # required for scoreboard; http(s) only
HEALTH_ALLOWED_HOSTS=             # comma list of host[:port]; default = the URL's own host
HEALTH_POLL_SEC=15
INGEST_TOKEN=                     # >= 32 chars; required for ingest, route returns 404 when unset

# Security (docs/12 §9)
TEAM_SELF_RESET=false             # spec says teams may reset their own env; the club says no. Default off.
TRUST_PROXY=false                 # true only behind your own reverse proxy: then X-Forwarded-For (rightmost) is the client IP
COOKIE_SECURE=false               # true when served over HTTPS; also set automatically when X-Forwarded-Proto=https
